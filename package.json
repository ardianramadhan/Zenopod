{
  "name": "kapsul",
  "version": "0.8.0",
  "private": true,
  "description": "Zenopod: widget desktop pribadi dengan maskot Zeno (Windows & macOS).",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "test": "node --test",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "release": "electron-builder --win nsis --publish always",
    "docs:sync": "node scripts/sync-docs.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "electron-updater": "^6.8.9",
    "node-ical": "^0.27.3"
  },
  "author": "Awaludhi Ardian",
  "build": {
    "appId": "id.zenopod.app",
    "productName": "Zenopod",
    "copyright": "Zenopod",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-settings.js",
      "preload-snip.js",
      "bridge.ps1",
      "lib/**",
      "hooks/**",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "bridge.ps1",
      "hooks/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zenopod",
      "artifactName": "Zenopod-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "build/mac/zenopod-helper",
          "to": "zenopod-helper"
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Zenopod mendengarkan perintah suara hanya saat kamu menekan tombol pintasnya.",
        "NSAppleEventsUsageDescription": "Zenopod mengontrol Spotify/Music, volume, dan menu daya atas perintahmu.",
        "NSScreenCaptureUsageDescription": "Zenopod membaca layar hanya saat kamu memakai Ambil teks dari layar."
      }
    },
    "dmg": {
      "artifactName": "Zenopod-${version}-${arch}.dmg",
      "title": "Zenopod ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ardianramadhan",
        "repo": "Zenopod"
      }
    ]
  }
}
